      <Contracts>Must fail closed on denylist, delete, bulk move, missing dry-run, autonomous 70_Wiki write and symlink acceptance.</Contracts>
    </M-003>

    <M-004 NAME="VaultReadService" TYPE="CORE_LOGIC" verification-ref="V-M-004">
      <Purpose>Provides safe read/list/exists/metadata operations over allowed Vault paths.</Purpose>
