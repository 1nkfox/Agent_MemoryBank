        <fn-write_note id="KG-M-001-FN-006" flow-ref="DF-002" />
        <fn-promote_note id="KG-M-001-FN-007" flow-ref="DF-006" />
        <fn-propose_wiki_update id="KG-M-001-FN-008" flow-ref="DF-005" />
        <fn-refresh_paths id="KG-M-001-FN-009" flow-ref="DF-004" />
        <fn-health_check id="KG-M-001-FN-010" />
        <fn-backup_vault id="KG-M-001-FN-011" />
        <fn-backup_health id="KG-M-001-FN-012" />
