  <Concepts id="KG-CONCEPTS-001">
    <Concept id="C-001" name="VaultIsTruth">Markdown files in Obsidian Vault are the primary durable knowledge source.</Concept>
    <Concept id="C-002" name="IndexIsDerivative">SQLite FTS, vector tables and projections can be rebuilt from Vault content.</Concept>
    <Concept id="C-003" name="RevisionIsContentHash">revision equals sha256(content), not mtime or size.</Concept>
    <Concept id="C-004" name="WritesArePlanned">Mutations require policy, plan, dry-run, revision recheck and audit.</Concept>
    <Concept id="C-005" name="WikiIsProposeOnly">70_Wiki receives proposals and diffs, not autonomous writes.</Concept>
    <Concept id="C-006" name="AgentsNeverDelete">Delete operations are outside MVP and denied by policy.</Concept>
  </Concepts>

