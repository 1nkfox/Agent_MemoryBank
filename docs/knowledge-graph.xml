      <TargetPath>src/memory_mcp/server.py</TargetPath>
      <PublicInterface>
        <fn-read_note id="KG-M-001-FN-001" flow-ref="DF-001" />
        <fn-search_notes id="KG-M-001-FN-002" flow-ref="DF-003" />
        <fn-create_note id="KG-M-001-FN-003" flow-ref="DF-002" />
